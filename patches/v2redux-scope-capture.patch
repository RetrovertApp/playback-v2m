@@ -692,6 +692,13 @@ struct V2Instance
   // from chan[]/written to this side buffer -- never alters the rendered bits.
   sF32 chanPeak[16];   // 16 == V2Synth::CHANS (not in scope here)
 
+  // per-channel scope ring buffers (display-only, same contract as chanPeak):
+  // the last SCOPE_SIZE mono samples of each channel's post-FX signal.
+  enum { SCOPE_SIZE = 2048, SCOPE_MASK = SCOPE_SIZE - 1 };
+  sF32 scopeBuf[16][SCOPE_SIZE];
+  sU32 scopePos[16];
+  sU32 scopeOn;
+
   // buffers
   sF32 vcebuf[MAX_FRAME_SIZE];
   sF32 vcebuf2[MAX_FRAME_SIZE];
@@ -3399,6 +3406,14 @@ struct V2Chan
       }
       pk *= chgain;
       if (pk > inst->chanPeak[chanIndex]) inst->chanPeak[chanIndex] = pk;
+
+      if (inst->scopeOn)
+      {
+        sU32 w = inst->scopePos[chanIndex];
+        for (sInt i = 0; i < nsamples; i++, w++)
+          inst->scopeBuf[chanIndex][w & V2Instance::SCOPE_MASK] = (chan[i].l + chan[i].r) * 0.5f;
+        inst->scopePos[chanIndex] = w;
+      }
     }
 
     // Muted channels render fully (above) but feed NO output bus -- not the main
@@ -4604,6 +4619,32 @@ void __stdcall synthGetChannelPeaks(void *pthis, float *dest16)
   for (int i = 0; i < 16; i++) { dest16[i] = s->instance.chanPeak[i]; s->instance.chanPeak[i] = 0.0f; }
 }
 
+void __stdcall synthEnableScopeCapture(void *pthis, int enable)
+{
+  V2Synth *s = (V2Synth *)pthis;
+  if (!s->initialized) return;
+  s->instance.scopeOn = enable ? 1 : 0;
+  if (enable)
+  {
+    memset(s->instance.scopeBuf, 0, sizeof(s->instance.scopeBuf));
+    memset(s->instance.scopePos, 0, sizeof(s->instance.scopePos));
+  }
+}
+
+unsigned int __stdcall synthGetScopeData(void *pthis, int channel,
+                                         float *buffer, unsigned int numSamples)
+{
+  V2Synth *s = (V2Synth *)pthis;
+  if (!s->initialized || !s->instance.scopeOn || !buffer) return 0;
+  if (channel < 0 || channel >= V2Synth::CHANS) return 0;
+  if (numSamples > (unsigned int)V2Instance::SCOPE_SIZE)
+    numSamples = (unsigned int)V2Instance::SCOPE_SIZE;
+  sU32 w = s->instance.scopePos[channel];
+  for (unsigned int i = 0; i < numSamples; i++)
+    buffer[i] = s->instance.scopeBuf[channel][(w - numSamples + i) & V2Instance::SCOPE_MASK];
+  return numSamples;
+}
+
 void __stdcall synthGetPgm(void *pthis, void *dest)
 {
   ((V2Synth *)pthis)->getPgm((sInt*)dest);
