+++ b/src/v2player.cpp
@@ -174,4 +174,17 @@ void Player::getChannelLevels(float *dest16)
   impl_->seq.GetChannelPeaks((sF32 *)dest16);
 }
 
+void Player::setScopeEnabled(bool on)
+{
+  if (impl_->opened)
+    impl_->seq.EnableScope(on ? sTRUE : sFALSE);
+}
+
+uint32_t Player::getScopeSamples(int channel, float *out, uint32_t cap)
+{
+  if (!impl_->opened)
+    return 0;
+  return (uint32_t)impl_->seq.GetScope((sInt)channel, (sF32 *)out, (sU32)cap);
+}
+
 } // namespace v2redux
